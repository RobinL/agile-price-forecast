{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public seven-day Agile forecast v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "issued_at",
    "generated_at",
    "timezone",
    "region",
    "unit",
    "model",
    "sources",
    "notes",
    "accuracy",
    "slots",
    "horizon_hours",
    "horizon_end",
    "calibration"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "mode": {
      "enum": ["demo", "replay", "live"]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "timezone": {
      "const": "Europe/London"
    },
    "region": {
      "const": "G"
    },
    "unit": {
      "const": "p/kWh including VAT"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "id", "trained_as_of", "training_rows", "recipe_id"],
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "trained_as_of": {
          "type": "string",
          "format": "date-time"
        },
        "training_rows": {
          "type": "integer",
          "minimum": 1
        },
        "recipe_id": {
          "type": "string"
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time"
          },
          "provider_updated_at": {
            "type": ["string", "null"]
          },
          "sha256": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "accuracy": {
      "anyOf": [
        {
          "type": ["object", "null"],
          "properties": {
            "description": {
              "type": "string"
            },
            "baseline": {
              "type": "string"
            },
            "data_mode": {
              "type": "string"
            },
            "training_input_note": {
              "type": "string"
            },
            "evaluated_as_of": {
              "type": "string",
              "format": "date-time"
            },
            "model_trained_as_of": {
              "type": "string",
              "format": "date-time"
            },
            "target_start": {
              "type": "string",
              "format": "date-time"
            },
            "target_end": {
              "type": "string",
              "format": "date-time"
            },
            "slots": {
              "type": "integer",
              "minimum": 1
            },
            "issue_days": {
              "type": "integer",
              "minimum": 1
            },
            "model_mae_p_kwh": {
              "type": "number",
              "minimum": 0
            },
            "week_earlier_mae_p_kwh": {
              "type": "number",
              "minimum": 0
            },
            "recipe_id": {
              "const": "linear-ridge-v1"
            }
          },
          "required": [
            "description",
            "baseline",
            "data_mode",
            "training_input_note",
            "evaluated_as_of",
            "model_trained_as_of",
            "target_start",
            "target_end",
            "slots",
            "issue_days",
            "model_mae_p_kwh",
            "week_earlier_mae_p_kwh",
            "recipe_id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "recipe_id",
            "recipe_fingerprint",
            "evaluated_as_of",
            "target_start",
            "target_end",
            "issue_days",
            "comparison",
            "by_horizon",
            "description"
          ],
          "properties": {
            "kind": {
              "const": "research-comparison"
            },
            "recipe_id": {
              "const": "level-shape-v1"
            },
            "recipe_fingerprint": {
              "type": "string"
            },
            "description": {
              "type": "string"
            },
            "issue_days": {
              "type": "integer",
              "minimum": 1
            },
            "comparison": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["model", "mae_p_kwh", "slots"],
                "properties": {
                  "model": {
                    "type": "string"
                  },
                  "mae_p_kwh": {
                    "type": ["number", "null"],
                    "minimum": 0
                  },
                  "slots": {
                    "type": "integer",
                    "minimum": 0
                  }
                }
              }
            },
            "by_horizon": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["day_ahead", "comparison"],
                "additionalProperties": false,
                "properties": {
                  "day_ahead": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 7
                  },
                  "comparison": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["model", "mae_p_kwh", "slots"],
                      "properties": {
                        "model": {
                          "type": "string"
                        },
                        "mae_p_kwh": {
                          "type": ["number", "null"],
                          "minimum": 0
                        },
                        "slots": {
                          "type": "integer",
                          "minimum": 0
                        }
                      }
                    }
                  }
                }
              }
            },
            "evaluated_as_of": {
              "type": "string",
              "format": "date-time"
            },
            "target_start": {
              "type": "string",
              "format": "date-time"
            },
            "target_end": {
              "type": "string",
              "format": "date-time"
            }
          }
        }
      ]
    },
    "slots": {
      "type": "array",
      "minItems": 336,
      "maxItems": 386,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "start",
          "end",
          "day",
          "minute",
          "clock",
          "utc_offset_minutes",
          "price",
          "status",
          "policy"
        ],
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time"
          },
          "end": {
            "type": "string",
            "format": "date-time"
          },
          "day": {
            "type": "string",
            "format": "date"
          },
          "minute": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1439
          },
          "clock": {
            "type": "string"
          },
          "utc_offset_minutes": {
            "enum": [0, 60]
          },
          "price": {
            "type": ["number", "null"]
          },
          "status": {
            "enum": ["published", "predicted", "unavailable"]
          },
          "policy": {
            "enum": [
              "published",
              "unavailable",
              "research-48-72",
              "ensemble-experimental",
              "linear-baseline"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "unavailable"
                }
              }
            },
            "then": {
              "properties": {
                "price": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "price": {
                  "type": "number"
                }
              }
            }
          }
        ]
      }
    },
    "horizon_hours": {
      "const": 168
    },
    "horizon_end": {
      "type": "string",
      "format": "date-time"
    },
    "calibration": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["value", "samples", "issue_days", "warming_up"],
      "properties": {
        "value": {
          "type": "number"
        },
        "samples": {
          "type": "integer",
          "minimum": 0
        },
        "issue_days": {
          "type": "integer",
          "minimum": 0
        },
        "warming_up": {
          "type": "boolean"
        }
      }
    }
  }
}
