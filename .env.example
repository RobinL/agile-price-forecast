# Only for the explicit one-time seed or a manual private-state download.
# Copy to .env (ignored by Git); never use VITE_ prefixes for these values.
# Use a separate local credential if production keys are reserved for Actions.
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=agile-forecast-state
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
